# Google reCAPTCHA v3 Site Key (public key - safe to expose in frontend)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Google Drive API for dynamic portfolio
# Get API key from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# Google Drive Folder ID (the 'website' folder ID)
# Get from the folder URL: https://drive.google.com/drive/folders/[FOLDER_ID_HERE]
VITE_GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
